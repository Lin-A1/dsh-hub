{
  "name": "dsh-packager",
  "version": "0.1.1-rc.2",
  "private": true,
  "type": "module",
  "description": "Out-of-box packager for deepseek-harness (dsh) 鈥?specify DSH_DIR and build desktop installer without patching dsh",
  "author": "Lin-A1 <860693883@qq.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lin-A1/dsh-packager.git"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "main": "src/main.mjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:fixed": "node scripts/build-fixed.mjs",
    "catalog": "node scripts/list-plugins.mjs",
    "build:dir": "node scripts/build.mjs --dir",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:packager": "electron-builder --config electron-builder.packager.yml --win",
    "dist:desktop": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "typecheck": "tsc --noEmit",
    "dev": "electron .",
    "dev:builder": "electron . -- --builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "execa": "^9.5.1",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "electron": "32.2.0",
    "electron-builder": "25.1.8",
    "electron-packager": "17.1.2",
    "png-to-ico": "^3.0.2",
    "png2icons": "^2.0.1",
    "sharp": "^0.35.3",
    "typescript": "6.0.3"
  }
}
